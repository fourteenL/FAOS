{
    "$schema":  "../node_modules/@tauri-apps/cli/config.schema.json",
    "productName":  "FAOS",
    "version":  "0.1.0-beta.2",
    "identifier":  "com.faos.app",
    "build":  {
                  "frontendDist":  "../dist",
                  "devUrl":  "http://localhost:5173",
                  "beforeDevCommand":  "npm run dev",
                  "beforeBuildCommand":  "npm run build"
              },
    "app":  {
                "windows":  [
                                {
                                    "title":  "FAOS 差价套利",
                                    "width":  1400,
                                    "height":  900,
                                    "resizable":  true,
                                    "fullscreen":  false
                                }
                            ],
                "security":  {
                                 "csp":  null
                             }
            },
    "bundle":  {
                   "active":  true,
                   "targets":  "all",
                   "icon":  [
                                "icons/32x32.png",
                                "icons/128x128.png",
                                "icons/128x128@2x.png",
                                "icons/icon.icns",
                                "icons/icon.ico"
                            ],
                   "resources":  {
                                     "pyembed/python":  "./",
                                     "../config/settings.dist.json":  "config/settings.local.json",
                                     "../config/contract_seed.json":  "config/contract_seed.json"
                                 },
                   "windows":  {
                                   "nsis":  {
                                                "installerHooks":  "./nsis/hooks.nsh",
                                                "languages":  [
                                                                  "SimpChinese"
                                                              ],
                                                "compression":  "zlib",
                                                "installMode":  "perMachine"
                                            }
                               }
               }
}
